def calculate_metrics(clean_orders: list[dict], invalid_orders: list[dict]) -> dict:
    orders_count = 0
    paid_orders_count = 0
    cancelled_orders_count = 0
    paid_revenue = 0
    high_orders_count = 0
    clean_orders_revenue = 0

    for order in clean_orders:
        val = order["amount"]
        status = order["status"]
        if status == "paid":
            paid_orders_count += 1
            paid_revenue += val
        if status == "cancelled":
            cancelled_orders_count += 1
        if order["order_tier"] == "high":
            high_orders_count += 1
        orders_count += 1
        clean_orders_revenue += val

    return {
        "Valid orders count": len(clean_orders),
        "Invalid orders count": len(invalid_orders),
        "Valid orders revenue": clean_orders_revenue,
        "Orders count": orders_count,
        "Paid orders count": paid_orders_count,
        "Cancelled orders count": cancelled_orders_count,
        "Paid revenue": paid_revenue,
        "High orders count": high_orders_count
   }

def print_raport(metrics: dict) -> None:
    for key, value in metrics.items():
        if "revenue" in key:
            print(f"{key}: {value:.2f}")
        else:
            print(f"{key}: {value}")

def paid_by_country(clean_orders: list[dict]) -> None:
    orders_count = 0
    revenue = 0
    revenue = round(revenue, 2)
    paid_by_country = {}
    for clean_order in clean_orders:
        country = clean_order["country"]
        val = clean_order["amount"]
        val = round(val, 2)
        if clean_order["status"] == "paid":
            if country not in paid_by_country:
                paid_by_country[country] = {
                    "orders_count": orders_count,
                    "revenue": revenue
                }
            paid_by_country[country]["orders_count"] += 1
            paid_by_country[country]["revenue"] += val
    paid_by_country = dict(sorted(paid_by_country.items()))
    print(paid_by_country)


