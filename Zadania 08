

def parse_amount(raw_amount: str) -> float:
    amount = raw_amount.replace(",", ".").strip()
    if amount is None or amount == "":
        raise ValueError
    amount = float(amount)
    if amount < 0:
        raise ValueError
    return amount


def normalize_country(country: str | None) -> str:
    if country is None or country.strip() == "":
        return "UNKNOWN"

    return country.strip().upper()


def get_order_tier(amount: float) -> str:
    if amount >= 200:
        return "high"

    return "standard"


def transform_order(raw_order: dict) -> dict:
    requirded_keys = ["id", "amount", "status"]
    for key in requirded_keys:
        if key not in raw_order:
            raise KeyError
    status = raw_order["status"].strip().lower()
    allowed_statuses = ["paid", "pending", "cancelled"]
    if status not in allowed_statuses:
        raise ValueError
    amount = parse_amount(raw_order["amount"])

    return {
        "order_id": int(raw_order["id"]),
        "country": normalize_country(raw_order["country"]),
        "amount": amount,
        "status": status,
        "order_tier": get_order_tier(amount),
    }

def validate_order(raw_order: list[dict], index: int, rejected_list: list) -> dict | bool:
    try:
        return transform_order(raw_order)
    except KeyError as ke:
        raw_id = raw_order.get("id")
        rejected_list.append({
            "order_index": index,
            "id": raw_id,
            "reason": str({ke})
        })
        return False
    except ValueError as ve:
        raw_id = raw_order.get("id")
        rejected_list.append({
            "order_index": index,
            "id": raw_id,
            "reason": str({ve})
        })
        return False



