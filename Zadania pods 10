def build_country_report(customers: list[dict], orders: list[dict]) -> dict:
    countries_summary = {}
    paying_customers = {}
    for customer in customers:
        country = customer["country"]
        if country not in countries_summary:
            countries_summary[country] = {
                "customers_count": 0,
                "paying_customers_count": 0,
                "paid_orders_count": 0,
                "paid_revenue": 0,
            }
            paying_customers[country] = set()
        countries_summary[country]["customers_count"] += 1

    customer_country = {customer["customer_id"]: customer["country"] for customer in customers}
    for order in orders:
        if order["status"] != "paid":
            continue
        customer_id = order["customer_id"]
        country = customer_country.get(customer_id)
        if country is None:
            continue
        countries_summary[country]["paid_orders_count"] += 1
        countries_summary[country]["paid_revenue"] += order["amount"]
        paying_customers[country].add(customer_id)

    for country in countries_summary:
        countries_summary[country]["paying_customers_count"] = len(paying_customers[country])

    return countries_summary

def print_country_report(report: dict) -> None:
    for country in sorted(report):
        print(country, report[country])

report = build_country_report(clean_customers, orders)
print_country_report(report)

