def get_customer_orders(customer_id: int, orders: list[dict]) -> list[dict]:
    orders_by_customer = [order for order in orders if customer_id == order["customer_id"]]
    return orders_by_customer

print(get_customer_orders(1, orders))

def build_customer_summary(customer: dict, orders: list[dict]) -> dict:
    customer_id = customer["customer_id"]
    customer_name = customer["name"]
    customer_orders = get_customer_orders(customer_id, orders)
    orders_count = len(customer_orders)
    paid_revenue = sum(
        order["amount"] for order in customer_orders if order["status"] == "paid"
    )
    avg_order_value = paid_revenue / orders_count if orders_count > 0 else None

    return {
        "customer_id": customer_id,
        "name": customer_name,
        "orders_count": orders_count,
        "paid_revenue": paid_revenue,
        "average_order_value": avg_order_value
    }
print(build_customer_summary(clean_customers[0], orders))

def build_all_summaries(customers: list[dict], orders: list[dict]) -> list[dict]:
    summaries = []
    for customer in customers:
        summary = build_customer_summary(customer, orders)

        summaries.append({
            **summary,
            "country": customer["country"],
            "customer_status": "buyer" if summary["orders_count"] > 0 else "no_orders",
        })
    return sorted(summaries, key=lambda s: (-s["paid_revenue"], s["customer_id"]))

summary = build_all_summaries(clean_customers, orders)
