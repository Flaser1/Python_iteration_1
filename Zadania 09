total_amount_by_id = {}
for order in rows:
    id = order["id"]
    amount = order["amount"]
    if id not in total_amount_by_id:
        total_amount_by_id[id] = {
            "amount": 0
        }
    total_amount_by_id[id]["amount"] += amount
